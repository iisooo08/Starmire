      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 2013866384324512787, guid: 0837d85eea62c4c619326065a798af51, type: 3}
      propertyPath: dialogue.Array.data[0]
      value: SO WHAT IS HAPPENING?!?!?!
      objectReference: {fileID: 0}
    - target: {fileID: 2013866384324512787, guid: 0837d85eea62c4c619326065a798af51, type: 3}
      propertyPath: dialogue.Array.data[1]
      value: Sorry, Your Majesty...we're currently searching everywhere...
      objectReference: {fileID: 0}
    - target: {fileID: 2013866384324512787, guid: 0837d85eea62c4c619326065a798af51, type: 3}
      propertyPath: dialogue.Array.data[2]
      value: Have you tried searching his room?
      objectReference: {fileID: 0}
    - target: {fileID: 2013866384324512787, guid: 0837d85eea62c4c619326065a798af51, type: 3}
      propertyPath: dialogue.Array.data[3]
      value: Uh...no, Your Majesty. We just knocked on the door, and he didn't respond,
        so...
      objectReference: {fileID: 0}
    - target: {fileID: 2013866384324512787, guid: 0837d85eea62c4c619326065a798af51, type: 3}
      propertyPath: dialogue.Array.data[4]
      value: 'We assumed he wasn''t there. '
      objectReference: {fileID: 0}
    - target: {fileID: 2013866384324512787, guid: 0837d85eea62c4c619326065a798af51, type: 3}
      propertyPath: dialogue.Array.data[5]
      value: WHAT?!?!?!
      objectReference: {fileID: 0}
    - target: {fileID: 2013866384324512787, guid: 0837d85eea62c4c619326065a798af51, type: 3}
      propertyPath: dialogue.Array.data[6]
      value: THEN GO LOOK FOR HIM!!! WHAT ARE YOU DOING!!!
      objectReference: {fileID: 0}
    - target: {fileID: 2013866384324512787, guid: 0837d85eea62c4c619326065a798af51, type: 3}
      propertyPath: dialogue.Array.data[7]
      value: THEN GO LOOK FOR HIM!!! WHAT ARE YOU DOING!!!
      objectReference: {fileID: 0}
    - target: {fileID: 2013866384324512787, guid: 0837d85eea62c4c619326065a798af51, type: 3}
      propertyPath: dialogue.Array.data[8]
